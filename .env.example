# ============ Configuración mínima ============

# Usuario y contraseña de acceso (la contraseña se hashea con bcrypt al arrancar)
APP_USERNAME=admin
APP_PASSWORD=

# ============ Opcional ============

# Nombre visible de la app y moneda
APP_NAME=Miney
DEFAULT_CURRENCY=EUR

# Clave para firmar la cookie de sesión. Si se deja vacía, se genera una
# aleatoria automáticamente y se guarda en <DATA_DIR>/secret_key (persistente).
SECRET_KEY=

# ============ Avanzado ============

# Alternativa a APP_PASSWORD: hash bcrypt en base64, generado con
#   python -m app.cli set-password "tu-contraseña"
# Tiene prioridad sobre APP_PASSWORD si ambas están definidas.
# (Se guarda en base64 porque Docker Compose corrompe el "$" de un hash bcrypt.)
APP_PASSWORD_HASH_B64=

# Ruta de la base de datos SQLite. En Docker la fija docker-compose a /data.
# Para desarrollo local sin Docker:
# DATABASE_URL=sqlite:///./data/misfinanzas_dev.db
